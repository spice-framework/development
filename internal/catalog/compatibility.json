{
  "schema": 2,
  "toolchains": {
    "go": "1.26.5",
    "java": "25",
    "goland": "2026.2.0.1"
  },
  "repositories": [
    {
      "name": ".github",
      "directory": ".github",
      "status": "active",
      "canonical_url": "https://github.com/spice-framework/.github",
      "clone_url": "https://github.com/spice-framework/.github.git",
      "artifact": "governance",
      "dependencies": [],
      "fast": [],
      "full": []
    },
    {
      "name": "development",
      "directory": "development",
      "status": "active",
      "canonical_url": "https://github.com/spice-framework/development",
      "clone_url": "https://github.com/spice-framework/development.git",
      "artifact": "go-module",
      "module": "github.com/spice-framework/development",
      "dependencies": [
        ".github"
      ],
      "fast": [
        {
          "name": "tests",
          "arguments": [
            "go",
            "test",
            "./..."
          ]
        }
      ],
      "full": [
        {
          "name": "complete verification",
          "arguments": [
            "go",
            "run",
            "./internal/qualitygate"
          ]
        }
      ]
    },
    {
      "name": "spice",
      "directory": "spice",
      "status": "active",
      "canonical_url": "https://github.com/spice-framework/spice",
      "clone_url": "https://github.com/spice-framework/spice.git",
      "artifact": "go-module",
      "module": "github.com/spice-framework/spice",
      "dependencies": [
        ".github",
        "development"
      ],
      "fast": [
        {
          "name": "warm quality gate",
          "arguments": [
            "go",
            "run",
            "./internal/qualitygate",
            "-mode=check"
          ]
        }
      ],
      "full": [
        {
          "name": "complete verification",
          "arguments": [
            "go",
            "run",
            "./internal/qualitygate",
            "-mode=verify"
          ]
        }
      ]
    },
    {
      "name": "petclinic",
      "directory": "petclinic",
      "status": "active",
      "canonical_url": "https://github.com/spice-framework/petclinic",
      "clone_url": "https://github.com/spice-framework/petclinic.git",
      "artifact": "go-module",
      "module": "github.com/spice-framework/petclinic",
      "dependencies": [
        ".github",
        "development",
        "spice"
      ],
      "fast": [
        {
          "name": "warm quality gate",
          "arguments": [
            "go",
            "run",
            "./internal/qualitygate",
            "-mode=check"
          ]
        }
      ],
      "full": [
        {
          "name": "complete verification",
          "arguments": [
            "go",
            "run",
            "./internal/qualitygate",
            "-mode=verify"
          ]
        }
      ]
    },
    {
      "name": "goland",
      "directory": "goland",
      "status": "active",
      "canonical_url": "https://github.com/spice-framework/goland",
      "clone_url": "https://github.com/spice-framework/goland.git",
      "artifact": "goland-plugin",
      "dependencies": [
        ".github",
        "development",
        "spice",
        "petclinic"
      ],
      "fast": [
        {
          "name": "plugin tests",
          "arguments": [
            "java",
            "-classpath",
            "gradle/wrapper/gradle-wrapper.jar",
            "org.gradle.wrapper.GradleWrapperMain",
            "--no-daemon",
            "--no-parallel",
            "--console=plain",
            "-PspiceCorePath=../spice",
            "-PpetclinicPath=../petclinic",
            "test"
          ]
        }
      ],
      "full": [
        {
          "name": "complete plugin verification",
          "arguments": [
            "java",
            "-classpath",
            "gradle/wrapper/gradle-wrapper.jar",
            "org.gradle.wrapper.GradleWrapperMain",
            "--no-daemon",
            "--no-parallel",
            "--console=plain",
            "-PspiceCorePath=../spice",
            "-PpetclinicPath=../petclinic",
            "verifyRepository"
          ]
        }
      ]
    },
    {
      "name": "zed",
      "directory": "zed",
      "status": "active",
      "canonical_url": "https://github.com/spice-framework/zed",
      "clone_url": "https://github.com/spice-framework/zed.git",
      "artifact": "zed-extension",
      "dependencies": [
        ".github",
        "development",
        "spice"
      ],
      "fast": [
        {
          "name": "locked Rust tests",
          "arguments": [
            "cargo",
            "test",
            "--locked"
          ]
        }
      ],
      "full": [
        {
          "name": "Rust formatting",
          "arguments": [
            "cargo",
            "fmt",
            "--check"
          ]
        },
        {
          "name": "Rust lint",
          "arguments": [
            "cargo",
            "clippy",
            "--locked",
            "--all-targets",
            "--",
            "-D",
            "warnings"
          ]
        },
        {
          "name": "locked Rust tests",
          "arguments": [
            "cargo",
            "test",
            "--locked"
          ]
        },
        {
          "name": "release WASI build",
          "arguments": [
            "cargo",
            "build",
            "--locked",
            "--release",
            "--target",
            "wasm32-wasip2"
          ]
        },
        {
          "name": "offline Spice fixture",
          "directory": "fixture",
          "arguments": [
            "go",
            "tool",
            "github.com/spice-framework/spice/cmd/spice",
            "verify",
            "--format=json",
            "./..."
          ]
        }
      ]
    }
  ]
